{
  "title": "한글 점자 규정",
  "source": "국립국어원 고시 제2017-12호 (2017.12.26.)",
  "reference_url": "https://kornorms.korean.go.kr/regltn/regltnView.do?regltn_code=0003",
  "categories": [
    {
      "id": "basic",
      "title": "1. 기본 자모 점자",
      "description": "한글 자모를 점자로 표기하는 기본 규칙",
      "rules": [
        {
          "title": "초성 (자음)",
          "examples": [
            { "korean": "ㄱ", "braille": "⠈", "description": "기역" },
            { "korean": "ㄴ", "braille": "⠉", "description": "니은" },
            { "korean": "ㄷ", "braille": "⠊", "description": "디귿" },
            { "korean": "ㄹ", "braille": "⠐", "description": "리을" },
            { "korean": "ㅁ", "braille": "⠑", "description": "미음" },
            { "korean": "ㅂ", "braille": "⠘", "description": "비읍" },
            { "korean": "ㅅ", "braille": "⠠", "description": "시옷" },
            { "korean": "ㅇ", "braille": "", "description": "이응 (초성에서는 표기하지 않음)" },
            { "korean": "ㅈ", "braille": "⠨", "description": "지읒" },
            { "korean": "ㅊ", "braille": "⠰", "description": "치읓" },
            { "korean": "ㅋ", "braille": "⠋", "description": "키읔" },
            { "korean": "ㅌ", "braille": "⠓", "description": "티읕" },
            { "korean": "ㅍ", "braille": "⠙", "description": "피읖" },
            { "korean": "ㅎ", "braille": "⠚", "description": "히읗" }
          ]
        },
        {
          "title": "중성 (모음)",
          "examples": [
            { "korean": "ㅏ", "braille": "⠣", "description": "아" },
            { "korean": "ㅓ", "braille": "⠎", "description": "어" },
            { "korean": "ㅗ", "braille": "⠥", "description": "오" },
            { "korean": "ㅜ", "braille": "⠍", "description": "우" },
            { "korean": "ㅡ", "braille": "⠪", "description": "으" },
            { "korean": "ㅣ", "braille": "⠕", "description": "이" },
            { "korean": "ㅐ", "braille": "⠗", "description": "애" },
            { "korean": "ㅔ", "braille": "⠝", "description": "에" }
          ]
        },
        {
          "title": "종성 (받침)",
          "examples": [
            { "korean": "ㄱ", "braille": "⠁", "description": "기역 받침" },
            { "korean": "ㄴ", "braille": "⠒", "description": "니은 받침" },
            { "korean": "ㄹ", "braille": "⠂", "description": "리을 받침" },
            { "korean": "ㅁ", "braille": "⠢", "description": "미음 받침" },
            { "korean": "ㅂ", "braille": "⠃", "description": "비읍 받침" },
            { "korean": "ㅇ", "braille": "⠶", "description": "이응 받침" }
          ]
        }
      ]
    },
    {
      "id": "numbers",
      "title": "2. 숫자 표기",
      "description": "숫자를 점자로 표기할 때는 숫자표(⠼)를 앞에 붙입니다",
      "rules": [
        {
          "title": "숫자표 + 숫자 점자",
          "note": "숫자표(⠼) 다음에 각 숫자를 점자로 표기",
          "examples": [
            { "korean": "0", "braille": "⠼⠚", "description": "숫자표 + 0(⠚)" },
            { "korean": "1", "braille": "⠼⠁", "description": "숫자표 + 1(⠁)" },
            { "korean": "2", "braille": "⠼⠃", "description": "숫자표 + 2(⠃)" },
            { "korean": "123", "braille": "⠼⠁⠃⠉", "description": "숫자표 + 1, 2, 3" },
            { "korean": "2024", "braille": "⠼⠃⠚⠃⠙", "description": "숫자표 + 2, 0, 2, 4" }
          ]
        }
      ]
    },
    {
      "id": "english",
      "title": "3. 영문자 표기",
      "description": "영문자를 표기할 때는 영어표(⠰)를 앞에 붙이고, 대문자는 대문자표(⠠)를 추가합니다",
      "rules": [
        {
          "title": "소문자",
          "note": "영어표(⠰) + 알파벳 점자",
          "examples": [
            { "korean": "a", "braille": "⠰⠁", "description": "영어표 + a" },
            { "korean": "hello", "braille": "⠰⠓⠑⠇⠇⠕", "description": "영어표 + h, e, l, l, o" }
          ]
        },
        {
          "title": "대문자",
          "note": "영어표(⠰) + 대문자표(⠠) + 알파벳 점자",
          "examples": [
            { "korean": "A", "braille": "⠰⠠⠁", "description": "영어표 + 대문자표 + a" },
            { "korean": "Hello", "braille": "⠰⠠⠓⠑⠇⠇⠕", "description": "영어표 + 대문자H + ello" }
          ]
        }
      ]
    },
    {
      "id": "punctuation",
      "title": "4. 문장 부호",
      "description": "문장 부호를 점자로 표기하는 규칙",
      "rules": [
        {
          "title": "기본 문장 부호",
          "examples": [
            { "korean": ".", "braille": "⠲", "description": "마침표 (온점)" },
            { "korean": ",", "braille": "⠐", "description": "쉼표 (반점)" },
            { "korean": "?", "braille": "⠦", "description": "물음표" },
            { "korean": "!", "braille": "⠖", "description": "느낌표" },
            { "korean": ":", "braille": "⠐⠂", "description": "쌍점 (콜론)" },
            { "korean": ";", "braille": "⠰⠆", "description": "쌍반점 (세미콜론)" }
          ]
        },
        {
          "title": "인용 부호",
          "examples": [
            { "korean": "\"", "braille": "⠦", "description": "큰따옴표 시작" },
            { "korean": "\"", "braille": "⠴", "description": "큰따옴표 끝" },
            { "korean": "「", "braille": "⠦", "description": "낫표 시작" },
            { "korean": "」", "braille": "⠴", "description": "낫표 끝" }
          ]
        }
      ]
    },
    {
      "id": "contractions",
      "title": "5. 약자 규칙",
      "description": "자주 사용하는 단어나 어미를 줄여서 표기하는 규칙",
      "rules": [
        {
          "title": "전부 약자 (1음절)",
          "note": "한 글자 전체를 약자 하나로 표기",
          "examples": [
            { "korean": "가", "braille": "⠫", "description": "가 전부 약자" },
            { "korean": "나", "braille": "⠉", "description": "나 전부 약자" },
            { "korean": "것", "braille": "특수", "description": "것 전부 약자" },
            { "korean": "이", "braille": "⠊", "description": "이 전부 약자" },
            { "korean": "그", "braille": "⠁", "description": "그 전부 약자" }
          ]
        },
        {
          "title": "부분 약자 (어미/접속사)",
          "note": "자주 쓰이는 어미나 접속사를 줄여 표기",
          "examples": [
            { "korean": "그래서", "braille": "⠁⠎", "description": "그래서 약자" },
            { "korean": "그러나", "braille": "⠁⠉", "description": "그러나 약자" },
            { "korean": "그러면", "braille": "⠁⠑", "description": "그러면 약자" },
            { "korean": "그리고", "braille": "⠁⠊", "description": "그리고 약자" }
          ]
        }
      ]
    },
    {
      "id": "examples",
      "title": "6. 종합 예시",
      "description": "실제 문장에서의 점자 변환 예시",
      "rules": [
        {
          "title": "혼합 텍스트",
          "examples": [
            {
              "korean": "안녕하세요",
              "braille": "⠣⠒⠉⠱⠶⠚⠣⠠⠝⠬",
              "description": "한글 → 점자 변환"
            },
            {
              "korean": "점자 123",
              "braille": "⠨⠎⠢⠨⠣ ⠼⠁⠃⠉",
              "description": "한글 + 숫자"
            },
            {
              "korean": "Hello 세계",
              "braille": "⠰⠠⠓⠑⠇⠇⠕ ⠠⠝⠈⠌",
              "description": "영문 + 한글"
            },
            {
              "korean": "2024년 점자닷.",
              "braille": "⠼⠃⠚⠃⠙⠉⠱⠒ ⠨⠎⠢⠨⠣⠊⠣⠲",
              "description": "숫자 + 한글 + 부호"
            }
          ]
        }
      ]
    }
  ],
  "notes": [
    "이 규칙은 국립국어원의 '한글 점자 규정'을 기반으로 구현되었습니다.",
    "약자와 같은 일부 고급 규칙은 선택적으로 사용할 수 있습니다.",
    "점자닷은 기본적인 규칙을 충실히 따르며, 지속적으로 개선 중입니다."
  ]
}
